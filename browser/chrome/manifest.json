{
  "manifest_version": 3,
  "name": "下载器",
  "version": "1.0.0",
  "description": "将网页下载交给本机下载器。",
  "key": "",
  "permissions": ["downloads", "cookies", "storage", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "incognito": "split",
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "下载器" }
}
